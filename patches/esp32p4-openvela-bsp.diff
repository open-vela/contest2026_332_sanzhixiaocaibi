- *
- * Returned Value:
- *   Wi-Fi channel
- *
- ****************************************************************************/
-
-static int esp_freq_to_channel(uint16_t freq)
-{
-  int channel = 0;
-  if (freq >= 2412 && freq <= 2484)
-    {
-      if (freq == 2484)
-        {
-          channel = 14;
-        }
-      else
-        {
-          channel = freq - 2407;
-          if (channel % 5)
-            {
-              return 0;
-            }
-
-          channel /= 5;
-        }
-
-      return channel;
-    }
-
-  if (freq >= 5005 && freq < 5900)
-    {
-      if (freq % 5)
-        {
-          return 0;
-        }
-
-      channel = (freq - 5000) / 5;
-      return channel;
-    }
-
-  if (freq >= 4905 && freq < 5000)
-    {
-      if (freq % 5)
-        {
-          return 0;
-        }
-
-      channel = (freq - 4000) / 5;
-      return channel;
-    }
-
-  return 0;
-}
