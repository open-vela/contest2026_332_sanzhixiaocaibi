+/****************************************************************************
+ * Name: esp_set_handle  (backported for the new HAL's os.c)
+ ****************************************************************************/
+
+static int esp_set_handle(int cpu, int irq, intr_handle_t handle)
+{
+  if (g_handle_map[cpu][irq] != NULL)
+    {
+      return -EINVAL;
+    }
+
+  g_handle_map[cpu][irq] = handle;
+
+  return OK;
+}
+
+/****************************************************************************
+ * Name: esp_get_handle
+ ****************************************************************************/
+
+intr_handle_t esp_get_handle(int cpu, int irq)
+{
+  return g_handle_map[cpu][irq];
+}
+
+/****************************************************************************
+ * Name: esp_get_cpuint
+ ****************************************************************************/
+
+int esp_get_cpuint(int cpu, int irq)
+{
+  struct esp_nuttx_intr_handle_s *h =
+    (struct esp_nuttx_intr_handle_s *)g_handle_map[cpu][irq];
+
+  if (h == NULL)
+    {
+      return -EINVAL;
+    }
+
+  return h->cpuint;
+}
+
+/****************************************************************************
+ * Name: esp_setup_irq_with_flags_intrstatus
+ ****************************************************************************/
+
+int esp_setup_irq_with_flags_intrstatus(int source, int flags,
+                                        uint32_t intrstatusreg,
+                                        uint32_t intrstatusmask,
+                                        xcpt_t handler, void *arg)
+{
+  struct esp_nuttx_intr_handle_s *handle;
+  int irq = ESP_SOURCE2IRQ(source);
+  int cpuint;
+  irq_priority_t priority = ESP_IRQ_PRIORITY_DEFAULT;
+  irq_trigger_t type;
+  irqstate_t irqstate;
+
+  (void)intrstatusreg;
+  (void)intrstatusmask;
+
+  type = (flags & ESP_INTR_FLAG_EDGE) ? ESP_IRQ_TRIGGER_EDGE :
+                                        ESP_IRQ_TRIGGER_LEVEL;
+
+  irqstate = enter_critical_section();
+
+  cpuint = esp_cpuint_alloc(irq);
+  if (cpuint < 0)
+    {
+      leave_critical_section(irqstate);
+      return cpuint;
+    }
+
+  esp_route_intr(source, cpuint, priority, type);
+
+  irq_attach(irq, handler, arg);
+
+  handle = kmm_calloc(1, sizeof(struct esp_nuttx_intr_handle_s));
+  if (handle == NULL)
+    {
+      leave_critical_section(irqstate);
+      return -ENOMEM;
+    }
+
+  handle->irq = irq;
+  handle->cpuint = cpuint;
+
+  esp_set_handle(esp_cpu_get_core_id(), irq, (intr_handle_t)handle);
+
+  leave_critical_section(irqstate);
+
+  return cpuint;
+}
+
+
+int IRAM_ATTR up_irq_to_ndx(int irq)
+{
+  return irq < ESP_IRQ_FIRSTPERIPH ? irq : ESP_IRQ_DEMUX;
+}
