===== boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_bringup.c =====
--- boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_bringup.c.bak.trace	2026-09-20 04:22:43.441586026 -0700
+++ boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_bringup.c	2026-09-20 04:37:44.321415806 -0700
@@ -35,6 +35,7 @@
 #include <unistd.h>
 
 #include <nuttx/fs/fs.h>
+#include <nuttx/ioexpander/gpio.h>
 
 #include "esp_board_ledc.h"
 #include "esp_board_spiflash.h"
@@ -423,6 +424,44 @@
     {
       ierr("Failed to initialize GPIO Driver: %d\n", ret);
     }
+  else
+    {
+      /* 电脉卫士上电自检：通过 VFS 打开刚注册的 GPIO 字符设备并读回引脚
+       * 状态，证明驱动注册与 ioctl 通路都可用。
+       *
+       * 只读不写 —— /dev/gpio0 驱动的是三相断闸固态继电器（GPIO21），
+       * 上电自检期间绝不能主动拉高。
+       */
+
+      static const char * const devs[] =
+        {
+          "/dev/gpio0",   /* GPIO21 - 三相断闸 SSR */
+          "/dev/gpio1",   /* GPIO22 - 蜂鸣器       */
+          "/dev/gpio2"    /* RTC IO0               */
+        };
+
+      struct file filep;
+      int idx;
+
+      for (idx = 0; idx < 3; idx++)
+        {
+          bool val = false;
+          int r;
+
+          r = file_open(&filep, devs[idx], O_RDWR);
+          if (r < 0)
+            {
+              syslog(LOG_ERR, "GPIO selftest: open %s -> %d\n",
+                     devs[idx], r);
+              continue;
+            }
+
+          r = file_ioctl(&filep, GPIOC_READ, (unsigned long)&val);
+          syslog(LOG_INFO, "GPIO selftest: %s OK  read=%d  ioctl=%d\n",
+                 devs[idx], (int)val, r);
+          file_close(&filep);
+        }
+    }
 #endif
 
 #if defined(CONFIG_INPUT_BUTTONS) && defined(CONFIG_INPUT_BUTTONS_LOWER)

===== boards/risc-v/esp32p4/esp32p4-function-ev-board/src/Make.defs =====
--- boards/risc-v/esp32p4/esp32p4-function-ev-board/src/Make.defs.bak.guardd	2026-09-20 04:58:58.561174824 -0700
+++ boards/risc-v/esp32p4/esp32p4-function-ev-board/src/Make.defs	2026-09-20 04:58:58.681174800 -0700
@@ -35,6 +35,11 @@
   CSRCS += esp32p4_gpio.c
 endif
 
+# 电脉卫士执行守护进程（作为 init 入口，见 esp32p4_guardd.c 顶部说明）
+ifeq ($(CONFIG_DEV_GPIO),y)
+  CSRCS += esp32p4_guardd.c
+endif
+
 ifeq ($(CONFIG_ARCH_BUTTONS),y)
   CSRCS += esp32p4_buttons.c
 endif

