# openvela / NuttX  ESP32-P4  本轮改动（成员C，2026-09-20）
#
# 1) esp_start.c        : 移除 nx_start() 之前对 esp_bringup() 的调用
#                         —— OS 未启动时 register_driver() 会死锁，开 DEV_GPIO 必踩
# 2) esp32p4_bringup.c  : GPIO 上电自检（只读，不驱动断闸继电器）
# 3) esp32p4_guardd.c   : 新增，电脉卫士执行守护进程（作为 init 入口）
# 4) src/Make.defs      : 纳入 esp32p4_guardd.c
# 5) esp_allocateheap.c : 早期堆边界打印（目前是正常启动的必要条件，根因未定位）
# 6) .config            : ESPRESSIF_USBSERIAL / 控制台改 USB-JTAG / init 入口改 guardd_main

===== arch/risc-v/src/common/espressif/esp_start.c =====
--- arch/risc-v/src/common/espressif/esp_start.c.bak.prebringup	2026-09-20 04:27:12.613536738 -0700
+++ arch/risc-v/src/common/espressif/esp_start.c	2026-09-20 04:27:21.297533592 -0700
@@ -520,10 +520,15 @@
 
   /* Bring up NuttX */
 
-  extern int esp_bringup(void);
-  ets_printf("ES:14g calling-esp_bringup\n");
-  int brv = esp_bringup();
-  ets_printf("ES:14h esp_bringup-ret=%d\n", brv);
+  /* NOTE: esp_bringup() must NOT be called here.  The OS is not running
+   * yet, so any VFS call inside it (register_driver(), nx_mount()) blocks
+   * forever on a mutex nothing can release.  This deadlocked as soon as
+   * CONFIG_DEV_GPIO was enabled.  esp32p4_boot.c already provides
+   * board_late_initialize(), which calls esp_bringup() at the right time,
+   * after nx_start() has the scheduler running.
+   */
+
+  ets_printf("ES:14g handing over to nx_start%c", 10);
   nx_start();
 
   for (; ; );

